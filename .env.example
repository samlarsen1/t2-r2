# Trading212 API. Read-only is enough: "Orders read" (history) and "Account data".
# Never give this key "Orders execute".
T212_API_KEY=your_api_key_here
T212_API_SECRET=your_api_secret_here
# Demo
#T212_BASE_URL=https://demo.trading212.com
# Live
T212_BASE_URL=https://live.trading212.com

# Optional. The SQLite ledger (default: var/ledger.db)
#T2R2_LEDGER_DB=var/ledger.db
# Optional. Folder holding the droids' app directories side by side (default: ..)
#T2R2_APPS_DIR=..
# Optional. Seconds between order history pages; Trading212 allows 6 a minute (default: 11)
#T2R2_HISTORY_PAGE_SECONDS=11

LOG_LEVEL=INFO
